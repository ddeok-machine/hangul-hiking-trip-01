; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hangul Hiking Trip: Hallasan"
run/main_scene="res://scenes/foraging/foraging.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="NHMH/HangulHikingTrip"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Hangul="*res://scripts/hangul.gd"
Content="*res://scripts/content.gd"
GameState="*res://scripts/game_state.gd"
Settings="*res://scripts/settings.gd"
InputPrompts="*res://scripts/input_prompts.gd"
Vibration="*res://scripts/vibration.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

